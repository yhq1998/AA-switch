<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 让 macOS / Linux 上也能编译（只是不能运行），CI 和本机都能尽早发现编译错误 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AA Switch</AssemblyName>
    <RootNamespace>AASwitch.Tray</RootNamespace>
    <!-- 版本号和 Mac 版共用仓库根目录的 VERSION 文件；构建时 -p:Version=… 可覆盖 -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\..\VERSION').Trim())</Version>
    <Product>AA Switch</Product>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\..\icon\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 官网 latest.json 的地址，发布构建时传 -p:UpdateUrl=…；不传就不检查更新 -->
    <AssemblyMetadata Include="UpdateUrl" Value="$(UpdateUrl)" />
    <ProjectReference Include="..\AASwitch.Core\AASwitch.Core.csproj" />
    <EmbeddedResource Include="..\..\icon\tray.ico" LogicalName="tray.ico" />
    <EmbeddedResource Include="..\..\icon\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
